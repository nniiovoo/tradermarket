[Unit]
Description=TraderMarket Live Room resolver authority 2
Documentation=file:///opt/tradermarket/docs/runbooks/LIVE_ROOM_OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradermarket
Group=tradermarket
WorkingDirectory=/opt/tradermarket/services/live-room
# The second resolver has its own configuration file and its own signer. Sharing
# resolver.env would make two processes repeat one attestation, not form quorum.
EnvironmentFile=/etc/tradermarket/resolver-2.env
ExecStart=/usr/bin/node --no-warnings scripts/operator.mjs resolver
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StateDirectory=tradermarket
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tradermarket
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
