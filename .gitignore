# Dependencies — restored by `npm ci`.
node_modules/

# Foundry build output and cache — regenerated by `forge build`.
# NOTE: contracts/lib is deliberately NOT ignored. It is vendored source with
# no .gitmodules, so ignoring it would leave a fresh clone unable to compile.
contracts/out/
contracts/cache/
broadcast/

# Frontend build output — regenerated by `npm run build`.
dist/

# Local databases. Every one of these is either regenerated or is a runtime
# artefact of a local session; none is configuration. A committed room.db would
# also carry session event logs and chat.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Agent tooling state. Large, machine-local, and meaningless in a diff.
.swarm/
.ruvector/
.claude-flow/
agentdb.rvf
agentdb.rvf.lock

# Secrets. `.env.example` files ARE tracked — they are the templates that tell
# an operator which variables exist, and their values are empty by design.
.env
.env.*
!.env.example

# macOS
.DS_Store
ruvector.db
